# Copiez ce fichier en .env (jamais commité) et remplacez chaque valeur.

# --- Base de données MySQL ---------------------------------------------
DOCKER_ROOT_PASSWORD=change-moi-root
DOCKER_DATABASE=vitamines_db
DOCKER_USER=vitamines
DOCKER_PASSWORD=change-moi
DOCKER_DATABASE_HOST=mysql

# --- Authentification JWT (RS256) --------------------------------------
# Clés sur une seule ligne, retours à la ligne écrits « \n ».
# Pour les générer, voir README.md > « Générer les clés JWT ».
JWT_PRIVATE="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
