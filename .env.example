# Copiez ce fichier en .env (jamais commité) et remplacez chaque valeur.

# --- Base de données MySQL ---------------------------------------------
DOCKER_ROOT_PASSWORD=change-moi-root
DOCKER_DATABASE=vitamines_db
DOCKER_USER=vitamines
DOCKER_PASSWORD=change-moi
DOCKER_DATABASE_HOST=mysql

# --- Authentification JWT (RS256) --------------------------------------
# Clés sur une seule ligne, retours à la ligne écrits « \n ».
# Pour les générer, voir README.md > « Générer les clés JWT ».
JWT_PRIVATE="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# --- Exécution ---------------------------------------------------------
# production : désactive Swagger (sauf API_DOCS=true) et active HSTS
NODE_ENV=development
# Origines autorisées à appeler l'API (séparées par des virgules ; vide = valeurs par défaut)
CORS_ORIGINS=
# Derrière un reverse proxy : 1 (nombre de proxys) pour que le limiteur voie l'IP réelle
TRUST_PROXY=
# API_DOCS=true

# --- Premier administrateur (créé au démarrage de l API si aucun admin n existe) ---
# Laisser vide pour ne rien créer. Mot de passe : 8 caractères min., une lettre et un chiffre.
# Après la première connexion, changez le mot de passe ou videz ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOM=Administrateur

# --- Docker ------------------------------------------------------------
# UID/GID propriétaires de vitamines/public/images/alimentsImages (commande : id -u / id -g)
APP_UID=1000
APP_GID=1000
# Interfaces et port publiés (127.0.0.1 = accessibles seulement depuis la machine)
API_BIND=127.0.0.1
FRONT_BIND=127.0.0.1
FRONT_PORT=80

# URL publique de l API (sans /api), utilisee par le front en production
VITE_API_URL=https://api.bryamsilva.online
